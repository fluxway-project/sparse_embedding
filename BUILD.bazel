"""
Core BUILD file for the sparse_embedding package.

Single unified _core.so target:
  multi-slot HogwildEmbeddingStore + DLPack zero-copy bindings + stdexec parallelism
"""

load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "format",
    srcs = ["scripts/format.sh"],
)

refresh_compile_commands(
    name = "refresh_compile_commands_internal",
    exclude_external_sources = True,
    tags = ["manual"],
    targets = {
        "//:sparse_embedding/_core.so": "",
    },
)

sh_binary(
    name = "refresh_compile_commands",
    srcs = ["scripts/refresh_compile_commands.sh"],
    tags = ["manual"],
)

cc_binary(
    name = "_core.so",
    srcs = [
        "//sparse_embedding/src/bindings:srcs",
        "//sparse_embedding/src/ops:srcs",
    ],
    copts = ["-fvisibility=hidden"],
    linkshared = True,
    deps = [
        "//sparse_embedding/src/backend/hogwild:hogwild_embedding_store",
        "//sparse_embedding/src/checkpoint",
        "//sparse_embedding/src/common",
        "//sparse_embedding/src/eviction",
        "//sparse_embedding/src/initializer",
        "//sparse_embedding/src/interface",
        "//sparse_embedding/src/optimizer",
        "@dlpack",
        "@nanobind",
        "@proxy",
    ],
)

genrule(
    name = "copy_core_so",
    srcs = [":_core.so"],
    outs = ["sparse_embedding/_core.so"],
    cmd = "cp $< $@",
)

# ---- _core.so with lance-c: opt-in build ----

genrule(
    name = "copy_liblance_c",
    srcs = ["@lance_c//:build_lance_c"],
    outs = ["sparse_embedding/liblance_c.so"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

cc_binary(
    name = "core_so_with_lance",
    srcs = [
        "//sparse_embedding/src/bindings:srcs",
        "//sparse_embedding/src/ops:srcs",
    ],
    copts = [
        "-DSE_ENABLE_LANCE_CHECKPOINTER",
        "-fvisibility=hidden",
    ],
    linkopts = ["-Wl,-rpath,$$ORIGIN"],
    linkshared = True,
    tags = ["manual"],
    deps = [
        "//sparse_embedding/src/backend/hogwild:hogwild_embedding_store",
        "//sparse_embedding/src/checkpoint",
        "//sparse_embedding/src/checkpoint:checkpoint_lance",
        "//sparse_embedding/src/common",
        "//sparse_embedding/src/eviction",
        "//sparse_embedding/src/initializer",
        "//sparse_embedding/src/interface",
        "//sparse_embedding/src/optimizer",
        "@dlpack",
        "@nanobind",
        "@proxy",
    ],
)

py_library(
    name = "sparse_embedding_lib",
    srcs = glob(["sparse_embedding/**/*.py"]),
    data = [
        ":copy_core_so",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_library(
    name = "sparse_embedding_lib_with_lance",
    srcs = glob(["sparse_embedding/**/*.py"]),
    data = [
        ":copy_core_so",
        ":copy_liblance_c",
    ],
    imports = ["."],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

py_wheel(
    name = "sparse_embedding_wheel",
    abi = "cp312",
    distribution = "sparse_embedding",
    platform = "manylinux2014_x86_64",
    python_requires = ">=3.11",
    python_tag = "cp312",
    version = "0.1.0",
    deps = [
        ":copy_core_so",
        ":sparse_embedding_lib",
    ],
)

py_wheel(
    name = "sparse_embedding_wheel_with_lance",
    abi = "cp312",
    distribution = "sparse_embedding",
    platform = "manylinux2014_x86_64",
    python_requires = ">=3.11",
    python_tag = "cp312",
    tags = ["manual"],
    version = "0.1.0",
    deps = [
        ":copy_core_so",
        ":copy_liblance_c",
        ":sparse_embedding_lib_with_lance",
    ],
)
