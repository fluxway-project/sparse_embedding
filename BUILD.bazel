"""
Core BUILD file for the sparse_embedding package.

Unified Python extension targets:
  multi-slot HogwildEmbeddingStore + DLPack zero-copy bindings + stdexec parallelism
"""

load("@hedron_compile_commands//:refresh_compile_commands.bzl", "refresh_compile_commands")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//:build_settings.bzl", "bool_flag")

bool_flag(
    name = "with_lance",
    build_setting_default = True,
)

config_setting(
    name = "lance_enabled",
    flag_values = {":with_lance": "true"},
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "format",
    srcs = ["scripts/format.sh"],
)

refresh_compile_commands(
    name = "refresh_compile_commands_internal",
    exclude_external_sources = True,
    tags = ["manual"],
    targets = {
        "//:core_extension": "",
    },
)

sh_binary(
    name = "refresh_compile_commands",
    srcs = ["scripts/refresh_compile_commands.sh"],
    tags = ["manual"],
)

cc_binary(
    name = "core_extension",
    srcs = [
        "//sparse_embedding/src/bindings:srcs",
        "//sparse_embedding/src/ops:srcs",
    ],
    copts = ["-fvisibility=hidden"],
    linkopts = ["-Wl,-rpath,$$ORIGIN"],
    linkshared = True,
    deps = [
        "//sparse_embedding/src/backend/hogwild:hogwild_embedding_store",
        "//sparse_embedding/src/bindings:checkpoint_instantiations",
        "//sparse_embedding/src/bindings:module",
        "//sparse_embedding/src/checkpoint",
        "//sparse_embedding/src/common",
        "//sparse_embedding/src/eviction",
        "//sparse_embedding/src/initializer",
        "//sparse_embedding/src/interface",
        "//sparse_embedding/src/optimizer",
        "@dlpack",
        "@nanobind",
        "@proxy",
        "@stdexec",
    ] + select({
        ":lance_enabled": ["//sparse_embedding/src/checkpoint:checkpoint_lance"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "package_core_extension",
    srcs = [":core_extension"],
    outs = ["sparse_embedding/_core.so"],
    cmd = "cp $< $@",
)

genrule(
    name = "package_liblance_c",
    srcs = ["@lance_c//:build_lance_c"],
    outs = ["sparse_embedding/liblance_c.so"],
    cmd = "cp $< $@",
    tags = ["manual"],
)

filegroup(
    name = "native_artifacts",
    srcs = [":package_core_extension"] + select({
        ":lance_enabled": [":package_liblance_c"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "package_data",
    srcs = [
        "sparse_embedding/py.typed",
        ":native_artifacts",
    ],
)

py_library(
    name = "sparse_embedding_lib",
    srcs = glob(
        ["sparse_embedding/**/*.py"],
        exclude = ["sparse_embedding/tests/**"],
    ),
    data = [":package_data"],
    imports = ["."],
    visibility = ["//visibility:public"],
)
