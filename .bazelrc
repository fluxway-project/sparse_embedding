build --cxxopt=-std=c++23
build --enable_runfiles=false

# Enable AVX512_BF16 extension to support bfloat16 at the hardware/compiler level.
build --copt=-mavx512bf16

# Set default compilation mode to release (opt) for maximum performance out of the box.
build --compilation_mode=opt

# ==============================================================================
# Release Configuration (Opt) — defaults to GCC
# ==============================================================================
# Usage: bazel build //...
# Default opt uses GCC's -flto. 
# For Clang, use: bazel build --config=opt_clang //...

build:opt --copt=-O3
build:opt --copt=-DNDEBUG
build:opt --copt=-fno-strict-aliasing
build:opt --linkopt=-flto
build:opt --copt=-march=native
build:opt --copt=-mtune=native

# ==============================================================================
# LTO Variants — optional overrides
# ==============================================================================
# Clang ThinLTO: bazel build --config=opt_clang //...
build:opt_clang --config=opt
build:opt_clang --repo_env=CC=clang
build:opt_clang --repo_env=CXX=clang++
build:opt_clang --features=thin_lto
build:opt_clang --linkopt=-Wl,-mllvm,-import-instr-limit=100

# ==============================================================================
# Debug Configuration (Dbg)
# ==============================================================================
# Usage: bazel build -c dbg //...
# Action: Forces the use of Clang. Disables optimizations and retains full
# debugging symbols to provide a superior debugging experience.

build:dbg --repo_env=CC=clang
build:dbg --repo_env=CXX=clang++
build:dbg --copt=-O0
build:dbg --copt=-g
build:dbg --copt=-DDEBUG
build:dbg --strip=never
