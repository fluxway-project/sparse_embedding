"""
lance-c C/C++ headers.

lance-c is a Rust crate that produces a C shared library (liblance_c.so).
This BUILD exports the headers for compilation; the shared library must be
linked separately (either prebuilt or via rules_rust cargo_build_script).
"""

load("@crate_index//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")

rust_shared_library(
    name = "build_lance_c",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        package_name = "third_party/lance_c",
    ),
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        package_name = "third_party/lance_c",
        proc_macro = True,
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        package_name = "third_party/lance_c",
        normal = True,
    ),
)

cc_library(
    name = "lance_c",
    srcs = [":build_lance_c"],
    hdrs = glob([
        "include/lance/*.h",
        "include/lance/*.hpp",
    ]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
