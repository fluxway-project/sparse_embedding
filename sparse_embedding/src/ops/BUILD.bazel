load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "*.hpp",
            "*.cpp",
        ],
        exclude = ["*_test.cpp"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "headers",
    srcs = glob(["*.hpp"]),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "ops",
    srcs = glob(
        ["*.cpp"],
        exclude = ["*_test.cpp"],
    ),
    hdrs = glob(["*.hpp"]),
    visibility = ["//visibility:public"],
    deps = [
        "//sparse_embedding/src/common",
        "@proxy",
        "@stdexec",
    ],
)

cc_test(
    name = "partitioner_registry_test",
    srcs = ["partitioner_registry_test.cpp"],
    deps = [
        ":ops",
    ],
)
