"""
BUILD file for checkpoint
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "partitioned_checkpoint",
    hdrs = [
        "partitioned_checkpoint.hpp",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "checkpoint_layout_schema",
    hdrs = [
        "lance/layout_schema.hpp",
