"""
BUILD file for bindings
"""

load("@rules_cc//cc:defs.bzl", "cc_library")

filegroup(
    name = "srcs",
    srcs = glob(
        [
            "*.hpp",
            "*.cpp",
            "*.inl",
            "typed/*.cpp",
            "typed/*.inl",
        ],
        exclude = [
            "module.cpp",
            "typed/*_construct.cpp",
            "typed/*_checkpoint.cpp",
            "typed/construct_dispatch_*.cpp",
            "typed/construct_store_*.cpp",
            "typed/module_checkpoint.cpp",
            "typed/optimizer_factory_*.cpp",
        ],
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "checkpoint_instantiations",
    srcs = glob(["typed/module_*_checkpoint.cpp"]),
    hdrs = glob([
        "*.hpp",
        "*.inl",
        "typed/*.inl",
    ]) + ["//sparse_embedding/src/ops:headers"],
    copts = ["-O0"] + select({
        "//:lance_enabled": ["-DSE_ENABLE_LANCE_C"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//sparse_embedding/src/backend/hogwild:hogwild_embedding_store",
        "//sparse_embedding/src/checkpoint",
        "//sparse_embedding/src/common",
        "//sparse_embedding/src/eviction",
        "//sparse_embedding/src/initializer",
        "//sparse_embedding/src/interface",
        "//sparse_embedding/src/optimizer",
        "@dlpack",
        "@nanobind",
        "@proxy",
    ] + select({
        "//:lance_enabled": ["//sparse_embedding/src/checkpoint:checkpoint_lance"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

cc_library(
    name = "module",
    srcs = ["module.cpp"],
    hdrs = glob([
        "*.hpp",
        "*.inl",
        "typed/*.inl",
    ]) + ["//sparse_embedding/src/ops:headers"],
    copts = select({
        "//:lance_enabled": ["-DSE_ENABLE_LANCE_C"],
        "//conditions:default": [],
    }),
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//sparse_embedding/src/backend/hogwild:hogwild_embedding_store",
        "//sparse_embedding/src/checkpoint",
        "//sparse_embedding/src/common",
        "//sparse_embedding/src/eviction",
        "//sparse_embedding/src/initializer",
        "//sparse_embedding/src/interface",
        "//sparse_embedding/src/optimizer",
        "@dlpack",
        "@nanobind",
        "@proxy",
    ] + select({
        "//:lance_enabled": ["//sparse_embedding/src/checkpoint:checkpoint_lance"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)
